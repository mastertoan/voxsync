<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Optional: start the VoxSync server at login. Install with `server/scripts/install-launchagent`
     (it fills in __SERVER_DIR__ and __HOME__). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.voxsync.server</string>
  <key>ProgramArguments</key>
  <array><string>__SERVER_DIR__/scripts/voxsync-server</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/.voxsync/server.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.voxsync/server.log</string>
</dict>
</plist>
